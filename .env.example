# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agent_memory
DB_USER=postgres
DB_PASSWORD=your_password_here

# If you run only the Compose DB (`docker compose up -d db`) and manage.py from the host,
# use the same user/password/port as docker-compose.yml (published 5455):
# DB_PORT=5455
# DB_USER=agent
# DB_PASSWORD=agent_secret

# MCP server settings (optional overrides)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Gmail SMTP for send_email tool (optional). Use an app password, not your normal login.
# Required for email when running under docker compose (see docker-compose.yml).
# EMAIL_USERNAME=you@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# Display name recipients see in the From header (default: Personal Agent)
# EMAIL_FROM_NAME=Personal Agent
