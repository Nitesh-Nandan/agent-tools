{
  "mcpServers": {
    "agent-kit-sse": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/client-sse",
        "http://localhost:7075/sse"
      ]
    },
    "agent-kit-stdio-local": {
      "command": "uv",
      "args": ["run", "main.py", "--transport", "stdio"],
      "env": {
        "DATABASE_URL": "postgresql://agent:agent_secret@localhost:5432/agent_memory"
      },
      "cwd": "/path/to/agent-kit"
    },
    "agent-kit-stdio-docker-run": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e", "DATABASE_URL=postgresql://agent:agent_secret@host.docker.internal:5432/agent_memory",
        "-e", "EMAIL_USERNAME=you@gmail.com",
        "-e", "EMAIL_PASSWORD=your-app-password",
        "-e", "EMAIL_FROM_NAME=Personal Agent",
        "agent-kit-image",
        "python",
        "main.py",
        "--transport",
        "stdio"
      ]
    }
  }
}
