{
  "mcpServers": {
    "agent-kit-sse": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/client-sse",
        "http://localhost:7075/sse"
      ]
    },
    "agent-kit-stdio-local": {
      "command": "uv",
      "args": ["run", "main.py", "--transport", "stdio"],
      "env": {
        "DATABASE_URL": "postgresql://agent:agent_secret@localhost:5455/agent_memory"
      },
      "cwd": "/Users/nn359v/workspace/nitesh/2026/agent-kit"
    },
    "agent-kit-stdio-docker-exec": {
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "/Users/nn359v/workspace/nitesh/2026/agent-kit/docker-compose.yml",
        "exec",
        "-i",
        "mcp",
        "python",
        "main.py",
        "--transport",
        "stdio"
      ]
    },
    "agent-kit-stdio-docker-run": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e", "DATABASE_URL=postgresql://agent:agent_secret@host.docker.internal:5455/agent_memory",
        "-e", "EMAIL_USERNAME=you@gmail.com",
        "-e", "EMAIL_PASSWORD=abcdefghijklmnop",
        "-e", "EMAIL_FROM_NAME=AI Coach",
        "agent-kit-image",
        "python",
        "main.py",
        "--transport",
        "stdio"
      ]
    }
  }
}
